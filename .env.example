# Copy this file to `.env` and adjust as needed.

APP_NAME=Mis gastos
# Base currency used for conversions (ARS, USD, ...).
CURRENCY=ARS
DEBUG=false

# SQLite file used for local data.
# Defaults to <project>/data/expenses.db when omitted.
# DATABASE_URL=sqlite:///./data/expenses.db

# Server settings used by `python -m app.main`
HOST=127.0.0.1
PORT=8000
